# PostgreSQL connection string
DATABASE_URL="postgresql://YOUR_POSTGRES_USER:YOUR_PASSWORD@localhost:5432/prera_db?schema=public"

# Backend settings
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Admin seed settings (change before use)
ADMIN_NAME=PRERA Admin
ADMIN_EMAIL=admin@prera.com
ADMIN_PASSWORD=change-this-password
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d


